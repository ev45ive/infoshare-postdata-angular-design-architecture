{
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "primeng": {
      "command": "npx",
      "args": ["-y", "@primeng/mcp"]
    },
    "storybook": {
      "command": "mcp-http",
      "args": ["http://localhost:6006/mcp"]
    }
  }
}
